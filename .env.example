# Add variable names only. Never put real secrets in this file.

# cTrader Open API OAuth2 credentials (see docs/ctrader.md for one-time setup)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCESS_TOKEN=

# cTrader account to trade under
CTRADER_ACCOUNT_LOGIN=
CTRADER_SYMBOL=XAUUSD
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035

# Demo account login number (fallback for CTRADER_ACCOUNT_LOGIN)
ctrader_demo_account_login_number=
