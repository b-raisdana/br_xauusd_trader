# Add variable names only. Never put real secrets in this file.
#
# The cTrader Open API surface was retired. If old CTRADER_* values still exist
# in a local .env, delete them there and revoke the credentials at cTrader.

# Application config override. Every field of config.Config can be overridden with a
# DLF_<FIELD_NAME> variable. DLF_ENVIRONMENT=production turns OFF Config.check_assertions,
# which weakens validation. Correctness gates must leave it at development.
DLF_ENVIRONMENT=development

# br_pre_commit tooling only (hook/pandera wrapper verbosity). It has NO effect on
# application assertions; setting ENVIRONMENT=production does not silence them.
ENVIRONMENT=development